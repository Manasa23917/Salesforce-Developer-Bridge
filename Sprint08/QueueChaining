public class ApplicationSyncJob implements Queueable {

    private Id applicationId;

    public ApplicationSyncJob(Id applicationId) {
        this.applicationId = applicationId;
    }

    public void execute(QueueableContext context) {

        System.debug('Application Sync Job Started');
        System.debug('Application Id: ' + applicationId);

        System.enqueueJob(
            new ApplicationNotificationJob(applicationId)
        );
    }
}

